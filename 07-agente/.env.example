# Formato provider:modelo. Providers aceitos: openai, anthropic, google_genai.
# Para anthropic ou google_genai, instale o pacote: uv add langchain-anthropic
# O modelo precisa suportar tool calling.
MODELO=openai:gpt-5.6-luna
OPENAI_API_KEY=sua-chave-aqui

# Gateway compativel com a API da OpenAI (ex.: OpenRouter). Com ele, todo modelo
# openai: passa pelo gateway, e MODELO usa o id do gateway:
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODELO=openai:anthropic/claude-sonnet-5

# Token dos webhooks e da consulta (Bearer, ou senha do Basic auth para o SNS).
# Sem nenhum token, a API fica aberta, inclusive a aprovacao: use somente localmente.
# WEBHOOK_TOKEN=um-segredo-longo
# Token do endpoint de aprovacao, diferente do WEBHOOK_TOKEN (que nao vale nele).
# Com WEBHOOK_TOKEN e sem APROVACAO_TOKEN, a aprovacao fica fechada (503).
# APROVACAO_TOKEN=outro-segredo-longo

# Limites do agente
# Acoes que pausam para aprovacao humana, separadas por virgula; vazio desliga
# ACOES_COM_APROVACAO=reverter_deploy
# Teto de chamadas ao modelo por incidente, somando todos os ciclos
# MAX_CHAMADAS_MODELO=15
# Acoes executadas por incidente, somando todos os ciclos
# MAX_ACOES=3
# Ciclos por incidente (1 + reentradas); depois disso, novo disparo escala
# MAX_CICLOS=3
# Alerta novo no mesmo servico ate N minutos apos uma acao e suprimido
# JANELA_SUPRESSAO_MIN=10
# Novo disparo ate N minutos apos o agente concluir resolvido e duplicado, nao
# reentrada: o alerta ainda esta limpando na origem. 0 desliga
# CARENCIA_REENTRADA_MIN=5

# Opcionais
# MODELO_TIMEOUT=60
# MODELO_MAX_RETRIES=2
# JANELA_INVESTIGACAO=30m
# CENARIOS_DIR=./cenarios

# Tracing no LangSmith (lido diretamente pelo LangChain)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=sua-chave-aqui
