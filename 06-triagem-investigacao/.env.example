# Formato provider:modelo. Providers aceitos: openai, anthropic, google_genai.
# Para anthropic ou google_genai, instale o pacote: uv add langchain-anthropic
MODELO=openai:gpt-5.6-luna
OPENAI_API_KEY=sua-chave-aqui

# Token exigido em todos os endpoints (Bearer, ou senha do Basic auth para o SNS).
# Sem ele, a API fica aberta: use somente localmente.
# WEBHOOK_TOKEN=um-segredo-longo

# Opcionais
# Modelo do roteador (uma chamada curta por alerta); default: o mesmo de MODELO
# MODELO_ROTEADOR=openai:gpt-5.6-luna
# Abaixo deste valor, a decisao do roteador vira escalacao para humano
# LIMIAR_CONFIANCA=0.7
# CATALOGO_RUNBOOKS=./runbooks/catalogo.json
# MODELO_TIMEOUT=30
# MODELO_MAX_RETRIES=2
# JANELA_INVESTIGACAO=30m
# CENARIOS_DIR=./cenarios

# Tracing no LangSmith (lido diretamente pelo LangChain)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=sua-chave-aqui
